      "trigger": "autorun", "cond": { "notFlag": "frost_enter" },
      "commands": [
        { "type": "message", "text": ["霜結の祠。吐く息が 白く 凍る、永久の 冬。", "壁という 壁に、青い 氷が 張りついている。"] },
        { "type": "message", "text": "最奥に、ひときわ 冷たい 王気が 満ちている——氷の 主が、眠っているのだ。" },
