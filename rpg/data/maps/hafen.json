      "commands": [
        { "type": "playBgm", "id": "town" },
        { "type": "message", "text": "森を 鎮めた 一行のもとへ、聖王国の 使者が 駆けつけた。" },
        { "type": "message", "name": "聖王国の 使者", "text": ["勇者よ。星の翳りを 鎮める 道は ただ 一つ。","世界に 散った 七つの『星核』を 集め、星の祭壇に 捧げるのだ。"] },
        { "type": "setChapter", "id": "ch2", "step": 0 },
        { "type": "setFlag", "key": "ch2_intro" },
        { "type": "message", "name": "シオン", "text": "星核、か。…（シオンの 横顔が、一瞬 だけ 曇った）" },
        { "type": "message", "name": "？？？", "text": "——星核? そりゃ 高く 売れそうだねェ。" },
        { "type": "message", "name": "シノ", "text": ["あたしは シノ。しがない 盗賊さ。","遺跡の お宝、あんたらに ついてけば 拝めそうだ。","用心棒も 兼ねて、混ぜとくれよ。"] },
        { "type": "addMember", "id": "shino" },
        { "type": "message", "text": ["（シノは すばやく、毒や 眠りで 敵を 崩すのが 得意。","メニューの『メンバー』で 前衛に 入れ替えられる。）"] },
        { "type": "message", "text": ["【第2章 裏切りの聖騎士】", "街の 御者に 話すと、東の『古代遺跡』へ 向かえる。"] }
      ]
    },
    {
      "trigger": "autorun",
      "cond": { "chapterAtLeast": "ch1", "notFlag": "ch1_join" },
      "commands": [
        { "type": "setFlag", "key": "ch1_join" },
        { "type": "playBgm", "id": "town" },
        { "type": "message", "text": ["何日も 歩き、ルゥは 宿場町ハーフェンに たどり着いた。"] },
        { "type": "message", "name": "ガロード", "text": ["——おい、ひとりで 旅か？ あぶなっかしいな。","おれは ガロード。流れの 剣闘士さ。","行く あてが ないなら、しばらく 付き合ってやる。"] },
        { "type": "addMember", "id": "garrod" },
        { "type": "message", "name": "フィーナ", "text": ["わたしも ごいっしょ させて ください。","フィーナと もうします。…あなたに、聞きたいことが あるのです。"] },
        { "type": "addMember", "id": "fina" },
        { "type": "message", "name": "？？？", "text": ["——よう、あぶなっかしい 旅人だな。さっきの ならず者、見事に かわしてたぜ。"] },
        { "type": "message", "name": "シオン", "text": ["おれは シオン。しがない 流れの 剣士さ。","ひとりで ユグルを 目指すって? ……ほっとけねえな。","しばらく 兄貴分として 付き合ってやるよ、弟。"] },
        { "type": "addMember", "id": "shion" },
        { "type": "message", "name": "シオン", "text": ["…なあ、その ペンダント。"] },
        { "type": "message", "name": "シオン", "text": ["……いや。なんでも ない。さあ、行こうぜ。"] },
        { "type": "message", "text": ["こうして、ルゥは なかまと——そして 初めての「兄」を 得た。","【MVP版】森の 奥の 巨獣ヴェルダンテを 倒すと、第1章は ひと区切り。"] }
      ]
    },
