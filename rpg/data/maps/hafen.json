                { "type": "message", "name": "フィーナ", "text": "…シオンさんにも、きっと 事情が あったはず。わたしは、まだ 信じたい。" },
                { "type": "message", "name": "ルゥ", "text": "兄さん……。（胸の おくが、少しだけ あたたかくなる）" },
                { "type": "addVar", "key": "forgiveness", "delta": 5 },
