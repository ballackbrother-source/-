        { "conditions": {}, "commands": [
          { "type": "message", "text": "小さな 焚き火が ゆれている。…まだ、語り合う 仲間は いない。" } ] },
        { "conditions": { "flag": "ch1_join", "notFlag": "ch2_intro" }, "commands": [
          { "type": "message", "text": "焚き火を 囲んで、ひと休み。" },
