  "events": [
    {
      "trigger": "autorun",
      "cond": { "flag": "betrayed", "notFlag": "ch3_seen" },
      "commands": [
        { "type": "playBgm", "id": "town" },
        { "type": "message", "text": ["——第3章 失われた光——","光を 失った 街。人々の 顔にも、暗い 影が さしている。"] },
        { "type": "message", "text": ["星核も、信じた 兄も 失った。打ちひしがれる ルゥ。"] },
        { "type": "message", "name": "フィーナ", "text": ["…ルゥ。まだ、終わって いません。","シオンが 星核を 奪った 理由を——確かめに いきましょう。"] },
        { "type": "message", "name": "ガロード", "text": "ああ。俺たちが ついてる。立て、ルゥ。" },
        { "type": "message", "text": ["散り散りに なりかけた 仲間が、ふたたび ルゥの もとに 集った。","——第4章。シオンの 真実を 追う 旅が 始まる。"] },
